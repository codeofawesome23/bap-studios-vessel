{% doc %}
  @prompt
    Create a responsive image gallery for past custom embroidered projects, with two equal-width columns on desktop and one column on mobile. Images must wrap automatically into additional rows as more are added, not shrink into a single horizontal row. Include an editable heading defaulting to 'Past Custom Embroidered Projects', individually selectable/uploadable images, consistent 12px gaps, and adjustable image aspect ratio. Match the existing theme styling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-project-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: rgb(var(--color-foreground, 28 30 31));
  }

  .ai-project-gallery-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: inherit;
    font: inherit;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.15;
  }

  .ai-project-gallery-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  .ai-project-gallery-{{ ai_gen_id }}__item {
    min-width: 0;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background: rgba(28, 30, 31, 0.06);
  }

  .ai-project-gallery-{{ ai_gen_id }}__item img,
  .ai-project-gallery-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-project-gallery-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-project-gallery-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 18px;
    color: rgb(var(--color-foreground, 28 30 31));
    text-align: center;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-project-gallery-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-project-gallery-{{ ai_gen_id }}__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ai-project-gallery-{{ ai_gen_id }}__heading {
      margin-bottom: 18px;
    }
  }
{% endstyle %}

<div class="ai-project-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-project-gallery-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-project-gallery-{{ ai_gen_id }}__grid">
    {% assign image_count = 0 %}
    {% for i in (1..8) %}
      {% assign image_key = 'gallery_image_' | append: i %}
      {% assign gallery_image = block.settings[image_key] %}
      {% if gallery_image != blank %}
        {% assign image_count = image_count | plus: 1 %}
        <div class="ai-project-gallery-{{ ai_gen_id }}__item">
          <img src="{{ gallery_image | image_url: width: 1400 }}" alt="{{ gallery_image.alt | escape }}" loading="lazy" width="{{ gallery_image.width }}" height="{{ gallery_image.height }}">
        </div>
      {% endif %}
    {% endfor %}
    {% if image_count == 0 %}
      <div class="ai-project-gallery-{{ ai_gen_id }}__item ai-project-gallery-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
      <p class="ai-project-gallery-{{ ai_gen_id }}__empty">Add project photos in the block settings to build your gallery.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Project image gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Past Custom Embroidered Projects"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1 / 1"
    },
    { "type": "header", "content": "Gallery images" },
    { "type": "image_picker", "id": "gallery_image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "gallery_image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "gallery_image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "gallery_image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "gallery_image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "gallery_image_6", "label": "Image 6" },
    { "type": "image_picker", "id": "gallery_image_7", "label": "Image 7" },
    { "type": "image_picker", "id": "gallery_image_8", "label": "Image 8" }
  ],
  "presets": [
    { "name": "Project image gallery" }
  ],
  "tag": null,
  "class": "project-image-gallery-block"
}
{% endschema %}